{
  "extends": "expo/tsconfig.base.json",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "plugins": [
      {
        "name": "@effect/language-service",
        "includeSuggestionsInTsc": false,
        "diagnosticSeverity": { "floatingEffect": "error" }
      }
    ],
    "types": [
      "node"
    ]
  },
  "include": [
    "src",
    "app.config.ts",
    "vitest.config.mts"
  ]
}
